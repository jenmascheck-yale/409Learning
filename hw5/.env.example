# Campus Customs HW5 — environment template (NO real secrets here)
# Copy to .env (kept out of git / out of the submission zip) and fill in the key,
# or keep the real key in a .env at the course root, outside this folder.

# AI calls go through the Portkey gateway to gpt-6-luna (only model allowed).
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_MODEL=gpt-6-luna
